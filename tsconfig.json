{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "allowJs": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "paths": {
            "@symfony/stimulus-bundle": ["./vendor/symfony/stimulus-bundle/assets/dist/loader.d.ts"]
        }
    },
    "include": ["assets/**/*", "types/**/*.d.ts"],
    "exclude": ["assets/vendor"]
}

{% extends 'base.html.twig' %}

{% block title %}Course index{% endblock %}

{% block body %}
  <div class="container">
    <div class="row">
      <aside class="md:col-auto course-aside">
        <button type="button" class="btn-subtle md:d-none" data-bs-toggle="drawer" data-bs-target="#courses-drawer" aria-controls="courses-drawer">
          Ouvrir la liste
        </button>

        <dialog class="md:drawer drawer-start" id="courses-drawer" aria-labelledby="courses-drawer-label">
          <div class="drawer-header">
            <h5 class="drawer-title" id="courses-drawer-label">Cours disponibles</h5>
            <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Fermer"></button>
          </div>

          <div class="drawer-body">
            <nav class="nav vstack md:my-4">
              {% for course in courses %}
                <div class="vstack row-gap-3">
                  <strong class="d-flex align-items-center gap-3 fw-semibold">
                    <i class="fa-brands fa-lg fa-{{ course.icon }}"></i>
                    {{ course.label }}
                  </strong>
                  <ul class="nav flex-column ps-4 chapter-list">
                    <li>
                      <a href="" class="nav-link">Aperçu</a>
                    </li>
                    {% for chapter in course.chapters %}
                      <li>
                        <a href="#" class="nav-link">{{ chapter.title }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endfor %}
            </nav>
          </div>
        </dialog>
      </aside>

      <div class="col">
        <h1>Liste des cours</h1>
        <p class="text-lg fw-light">
          Lorem ipsum dolor sit amet, consectetur adipisicing elit. Voluptates laudantium pariatur earum quia neque exercitationem dolore voluptatem accusamus molestiae inventore quibusdam rerum sequi enim ex doloremque, tempora nisi quo reiciendis!
        </p>
      </div>

      <div class="col-12 xl:col-auto course-aside"></div>
    </div>
  </div>
{% endblock %}

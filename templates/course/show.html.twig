{% extends 'base.html.twig' %}

{% block title %}Course{% endblock %}

{% block body %}
    <h1>Course</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ course.id }}</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ course.label }}</td>
            </tr>
            <tr>
                <th>Icon</th>
                <td>{{ course.icon }}</td>
            </tr>
            <tr>
                <th>IconColor</th>
                <td>{{ course.iconColor }}</td>
            </tr>
            <tr>
                <th>IconColorAlt</th>
                <td>{{ course.iconColorAlt }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_course_index') }}">back to list</a>

    <a href="{{ path('app_course_edit', {'id': course.id}) }}">edit</a>

    {{ include('course/_delete_form.html.twig') }}
{% endblock %}

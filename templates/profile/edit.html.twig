{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block body %}
  <div class="container">
    <div class="row">
      <div class="md:col-6 lg:col-4 md:ms-auto">
        <h1>Profil</h1>

        {{ form_start(form) }}
            {{ form_row(form.name) }}

            <button type="submit" class="btn-subtle theme-primary hover-lift mt-3">Enregistrer</button>
        {{ form_end(form) }}
      </div>
    </div>
  </div>
{% endblock %}

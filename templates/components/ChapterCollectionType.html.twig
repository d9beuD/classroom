<div{{ attributes }}>
  {{ form_start(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.excerpt) }}
    {{ form_row(form.position) }}

    {# Sorted by position so a re-render after a drag-and-drop keeps the new order. #}
    <div data-controller="sortable">
    {% for section in form.sections.children|sort((a, b) => a.position.vars.value <=> b.position.vars.value) %}
      {% set type = enum('App\\EntityEnum\\ChapterSectionType').tryFrom(section.type.vars.value) %}
      {# Not rendered = not submitted, so the form clears variant for non-callout sections. #}
      {% if type != enum('App\\EntityEnum\\ChapterSectionType').Callout %}
        {% do section.variant.setRendered %}
      {% endif %}
      <div class="card mb-3">
        <div class="card-header d-flex flex-row justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn-icon btn-text" aria-label="Déplacer" title="Déplacer" data-sortable-handle>
              <i data-lucide="grip-vertical" aria-hidden="true"></i>
            </button>
            {{ type ? type.label }}
          </div>
          {{ form_widget(section.vars.button_delete) }}
        </div>
        <div class="card-body p-0">
          {{ form_row(section, { label: false }) }}
        </div>
      </div>
    {% endfor %}
    </div>
    {% do form.sections.setRendered %}

    {# Ignored by live re-renders: Floating UI's inline styles on .menu would otherwise be carried onto whatever node the morph reuses it for. #}
    <div id="chapter-section-add-menu" data-live-ignore>
    <button class="btn-subtle theme-primary" type="button" data-bs-toggle="menu" aria-expanded="false">
      Ajouter
    </button>
    <div class="menu">
      {% for type in this.sectionTypes %}
        <button
          type="button"
          class="menu-item"
          data-action="live#action"
          data-live-action-param="addSection"
          data-live-type-param="{{ type.value }}"
        >{{ type.label }}</button>
      {% endfor %}
    </div>
  </div>

    <div class="text-end">
      <button class="btn-subtle theme-primary">{{ buttonLabel }}</button>
      <a href="{{ cancelUrl }}" class="btn-subtle">Annuler</a>
    </div>
  {{ form_end(form) }}
</div>

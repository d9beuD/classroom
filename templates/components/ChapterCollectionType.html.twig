{# Menu of section types; each item calls addSection, before the section at `position` if given. #}
{% macro section_type_menu(types, position = null) %}
  <div class="menu">
    {% for type in types %}
      <button
        type="button"
        class="menu-item"
        data-action="live#action"
        data-live-action-param="addSection"
        data-live-type-param="{{ type.value }}"
        {% if position is not null %}data-live-position-param="{{ position }}"{% endif %}
      >{{ type.label }}</button>
    {% endfor %}
  </div>
{% endmacro %}

<div{{ attributes }}>
  {{ form_start(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.excerpt) }}
    {{ form_row(form.position) }}

    {# Sorted by position so a re-render after a drag-and-drop keeps the new order. #}
    <div data-controller="sortable">
    {% for section in form.sections.children|sort((a, b) => a.position.vars.value <=> b.position.vars.value) %}
      {% set types = enum('App\\EntityEnum\\ChapterSectionType') %}
      {% set type = types.tryFrom(section.type.vars.value) %}
      {# Not rendered = not submitted, so the form clears variant/language for other section types. #}
      {% if type != types.Callout %}
        {% do section.variant.setRendered %}
      {% endif %}
      {% if type != types.Code %}
        {% do section.language.setRendered %}
      {% endif %}
      {# Monaco language id, for sections edited in Monaco instead of the textarea. #}
      {% set editor_language = type == types.Code ? (section.language.vars.value ?: 'plaintext') : (type == types.Mermaid ? 'mermaid' : null) %}
      {% if not loop.first %}
        {# Insert before this section. The id carries the position, so an ignored menu never goes stale. #}
        <div id="chapter-section-insert-{{ section.position.vars.value }}" class="d-flex justify-content-center py-1" data-live-ignore>
          <button class="btn-icon btn-text btn-xs" type="button" data-bs-toggle="menu" aria-expanded="false" aria-label="Insérer une section ici" title="Insérer une section ici">
            <i data-lucide="plus" aria-hidden="true"></i>
          </button>
          {{ _self.section_type_menu(this.sectionTypes, section.position.vars.value) }}
        </div>
      {% endif %}
      <div class="card" data-sortable-item>
        <div class="card-header d-flex flex-row justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn-icon btn-text" aria-label="Déplacer" title="Déplacer" data-sortable-handle>
              <i data-lucide="grip-vertical" aria-hidden="true"></i>
            </button>
            {{ type ? type.label }}
            {% if type == types.Code %}
              {% set language = enum('App\\EntityEnum\\ChapterSectionLanguage').tryFrom(section.language.vars.value) %}
              {# The real form field; the combobox below writes to it (see bootstrap_controller.ts). #}
              <input type="hidden" id="{{ section.language.vars.id }}" name="{{ section.language.vars.full_name }}" value="{{ section.language.vars.value }}">
              {% do section.language.setRendered %}
              {# Ignored by live re-renders: the combobox owns its toggle text and menu position. #}
              <div id="{{ section.language.vars.id }}_combobox" data-live-ignore>
                <button
                  class="btn-text combobox-toggle w-auto"
                  type="button"
                  data-bs-toggle="combobox"
                  data-bs-search="true"
                  data-bs-search-normalize="true"
                  data-combobox-input="{{ section.language.vars.id }}"
                  aria-label="Langage"
                >
                  <span class="combobox-value">{{ language ? language.label : 'Texte brut' }}</span>
                  <i data-lucide="chevron-down" class="combobox-caret" aria-hidden="true"></i>
                </button>
                <div class="menu">
                  <div class="combobox-search">
                    <input type="search" class="form-control form-control-sm combobox-search-input" placeholder="Rechercher…" aria-label="Rechercher un langage" autocomplete="off">
                  </div>
                  <button class="menu-item{{ language ? '' : ' selected' }}" type="button" data-bs-value="" aria-selected="{{ language ? 'false' : 'true' }}">Texte brut</button>
                  {% for case in enum_cases('App\\EntityEnum\\ChapterSectionLanguage') %}
                    <button class="menu-item{{ case == language ? ' selected' }}" type="button" data-bs-value="{{ case.value }}" aria-selected="{{ case == language ? 'true' : 'false' }}">{{ case.label }}</button>
                  {% endfor %}
                  <div class="combobox-no-results d-none">Aucun langage</div>
                </div>
              </div>
            {% endif %}
          </div>
          {{ form_widget(section.vars.button_delete) }}
        </div>
        <div class="card-body p-0">
          {% if editor_language %}
            <div data-controller="monaco" data-monaco-language-value="{{ editor_language }}">
              {{ form_row(section.content, { attr: section.content.vars.attr|merge({ 'data-monaco-target': 'input' }) }) }}
              {# Monaco owns this node: live re-renders must not touch it. #}
              <div id="{{ section.content.vars.id }}_editor" data-monaco-target="editor" data-live-ignore></div>
            </div>
          {% endif %}
          {{ form_row(section, { label: false }) }}
        </div>
      </div>
    {% endfor %}
    </div>
    {% do form.sections.setRendered %}

    {# Add after the last section. Ignored by live re-renders: Floating UI's inline styles on .menu would otherwise be carried onto whatever node the morph reuses it for. #}
    <div id="chapter-section-add-menu" class="d-flex justify-content-center py-1 mb-3" data-live-ignore>
      <button class="btn-icon btn-text btn-xs" type="button" data-bs-toggle="menu" aria-expanded="false" aria-label="Ajouter une section à la fin" title="Ajouter une section à la fin">
        <i data-lucide="plus" aria-hidden="true"></i>
      </button>
      {{ _self.section_type_menu(this.sectionTypes) }}
    </div>

    <div class="text-end">
      <button class="btn-subtle theme-primary">{{ buttonLabel }}</button>
      <a href="{{ cancelUrl }}" class="btn-subtle">Annuler</a>
    </div>
  {{ form_end(form) }}
</div>

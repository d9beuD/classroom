{% extends 'course/base.html.twig' %}

{% block title %}Chapter{% endblock %}

{% block breadcrumb %}
  <nav aria-label="breadcrumb" class="d-print-none">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <a href="{{ path('app_course_index') }}" class="breadcrumb-link">Cours</a>
      </li>
      <li class="breadcrumb-divider"></li>
      <li class="breadcrumb-item">
        <a href="{{ path('app_course_overview', { slug: course.slug }) }}" class="breadcrumb-link">{{ course.label }}</a>
      </li>
      <li class="breadcrumb-divider"></li>
      <li class="breadcrumb-item">
        <a href="#" class="breadcrumb-link active">{{ chapter.title }}</a>
      </li>
    </ol>
  </nav>
{% endblock %}

{% block main %}
    <h1>{{ chapter.title }}</h1>

    <p class="text-lg fw-light">
      {{ chapter.excerpt }}
    </p>

    <ul class="chapter-meta theme-primary">
      {% if chapter.author %}
        <li>
          <i data-lucide="user" aria-hidden="true"></i>
          <span class="fg-3">Auteur</span>
          <strong>{{ chapter.author.name }}</strong>
        </li>
      {% endif %}
      <li>
        <i data-lucide="calendar-plus" aria-hidden="true"></i>
        <span class="fg-3">Créé le</span>
        <time datetime="{{ chapter.createdAt|date('c') }}">{{ chapter.createdAt|date('d/m/Y') }}</time>
      </li>
      <li>
        <i data-lucide="calendar-clock" aria-hidden="true"></i>
        <span class="fg-3">Mis à jour le</span>
        <time datetime="{{ chapter.updatedAt|date('c') }}">{{ chapter.updatedAt|date('d/m/Y') }}</time>
      </li>
    </ul>

    {% if is_granted('ROLE_PROFESSOR') %}
      <div class="d-flex gap-3 bg-1 p-3 rounded d-print-none">
        <a href="{{ path('app_chapter_edit', { courseSlug: course.slug, chapterSlug: chapter.slug }) }}">Modifier</a>
        {{ include('chapter/_delete_form.html.twig') }}
      </div>
    {% endif %}

    {# Rendered when the chapter is saved (ChapterRenderer); user HTML is escaped there. #}
    <article class="chapter-content mt-5" data-controller="code-copy">
      {{ chapter.renderedContent|raw }}
    </article>

    {% set previous = chapter.sibling(-1) %}
    {% set next = chapter.sibling(1) %}
    {% if previous or next %}
      <nav class="py-9 mt-9 border-top d-print-none" aria-label="Chapitres">
        <div class="d-flex flex-column md:flex-row gap-3 md:gap-5 lh-1">
          {% if previous %}
            <a href="{{ path('app_chapter_show', { courseSlug: course.slug, chapterSlug: previous.slug }) }}" class="d-flex flex-column gap-2 p-5 text-decoration-none border rounded-5 flex-grow-1" rel="prev">
              <div class="fg-3">← Précédent</div>
              <div class="fw-semibold">{{ previous.title }}</div>
              <div class="fg-3">{{ course.label }}</div>
            </a>
          {% endif %}
          {% if next %}
            <a href="{{ path('app_chapter_show', { courseSlug: course.slug, chapterSlug: next.slug }) }}" class="d-flex flex-column gap-2 p-5 text-decoration-none text-end border rounded-5 flex-grow-1" rel="next">
              <div class="fg-3">Suivant →</div>
              <div class="fw-semibold">{{ next.title }}</div>
              <div class="fg-3">{{ course.label }}</div>
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
{% endblock %}
